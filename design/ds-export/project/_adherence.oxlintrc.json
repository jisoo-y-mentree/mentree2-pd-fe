      {
        "selector": "JSXOpeningElement[name.name='ArticleTag'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|hue|key|ref|className|style|children)$/]",
        "message": "<ArticleTag> doesn't accept that prop. Declared props: label, hue."
      },
      {
        "selector": "JSXOpeningElement[name.name='Avatar'] > JSXAttribute > JSXIdentifier[name!=/^(?:src|name|alt|size|key|ref|className|style|children)$/]",
        "message": "<Avatar> doesn't accept that prop. Declared props: src, name, alt, size."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|status|hue|leading|flag|flagBase|avatar|size|labelHidden|extraItems|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: variant, status, hue, leading, flag, flagBase, avatar, size, labelHidden, extraItems."
