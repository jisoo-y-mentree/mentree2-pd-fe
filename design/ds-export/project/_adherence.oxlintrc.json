{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/core/**",
              "components/forms/**",
              "components/navigation/**",
              "components/overlays/**",
              "components/surfaces/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Pretendard JP Variable))/i]",
        "message": "Font not provided by the design system. Available: Pretendard JP Variable."
      },
      {
        "selector": "JSXOpeningElement[name.name='AnswerCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:mentorName|mentorPhoto|country|countryLabel|activityLocation|headline|mentorProfileHref|mentorAnswersHref|body|date|liked|onLikeChange|likeCount|answerUrl|onCopyLink|accepted|isQuestionerView|onThanks|isMine|onEdit|onDelete|key|ref|className|style|children)$/]",
        "message": "<AnswerCard> doesn't accept that prop. Declared props: mentorName, mentorPhoto, country, countryLabel, activityLocation, headline, mentorProfileHref, mentorAnswersHref, body, date, liked, onLikeChange, likeCount, answerUrl, onCopyLink, accepted, isQuestionerView, onThanks, isMine, onEdit, onDelete."
